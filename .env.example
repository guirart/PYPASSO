# Copie para .env e preencha com os dados do seu projeto Supabase
# (Painel do Supabase → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Endereço público da política de privacidade (obrigatório para a Play Store)
EXPO_PUBLIC_PRIVACY_URL=https://seu-site/politica-de-privacidade.html
# Endereço dos termos de uso (aparece na tela do Plus)
EXPO_PUBLIC_TERMS_URL=https://seu-site/termos.html

# ---- PyPasso Plus (veja PAGAMENTOS.md). Sem estas chaves, o Plus fica em modo demonstração.
# Chaves PÚBLICAS do RevenueCat (Project settings > API keys), uma por loja
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_IOS_KEY=appl_xxxxxxxxxxxxxxxx
# Liga a assinatura pela web (Stripe: cartão e Pix Automático)
EXPO_PUBLIC_PLUS_WEB=1
